# Copy to .env and fill in. .env is gitignored and never committed.
#
#   cp .env.example .env

# Contact address for the OpenAlex and Crossref "polite pools".
# Optional. These APIs give faster, more reliable service to clients that
# identify themselves, and ask for a contact address to do it. Leave it unset
# and the pipeline simply omits the parameter; it does NOT send a placeholder,
# because a fake address in the polite pool is worse than no address.
CONTACT_EMAIL=you@example.org

# Optional, and only for the LLM refinement stages (make llm, make bench,
# make verify-additions). Everything else runs without it. See docs/llm-stage.md.
DEEPINFRA_API_KEY=
