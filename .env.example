# Copy to .env and fill in. .env is gitignored and never committed.
#
#   cp .env.example .env

# Contact address for the Crossref "polite pool".
# Optional. Crossref gives faster, more reliable service to clients that
# identify themselves, and asks for a contact address to do it. Leave it unset
# and the pipeline simply omits the parameter; it does NOT send a placeholder,
# because a fake address in the polite pool is worse than no address.
#
# Note this no longer buys anything from OpenAlex, which moved to a metered
# budget: a request with and without a mailto gets byte-identical rate headers.
# Use OPENALEX_API_KEY below for that.
CONTACT_EMAIL=you@example.org

# OpenAlex API key. Optional but strongly recommended, and free:
# get one at https://openalex.org/settings/api
#
# OpenAlex meters free use as a daily credit budget at $0.0001 per request,
# resetting at midnight UTC:
#
#     no key   $0.10/day   ~1,000 requests
#     free key $1.00/day   ~10,000 requests
#
# A full citation refresh touches ~3,700 identifiers, so the anonymous tier is
# exhausted by a single heavy day and everything afterwards returns HTTP 429.
# `make enrich` prints which tier it is running on, and stops with the reset
# time rather than filling the catalog with blanks.
OPENALEX_API_KEY=

# Optional, and only for the LLM refinement stages (make llm, make bench,
# make verify-additions). Everything else runs without it. See docs/llm-stage.md.
DEEPINFRA_API_KEY=
